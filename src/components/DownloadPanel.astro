---
import { downloads, formatSize } from "../config/downloads";
import Icon from "./Icon.astro";

const osIcon: Record<string, string> = {
  Windows: "windows",
  macOS: "apple",
  Linux: "linux",
};

const aux = [
  { k: "自动更新已内置", v: "安装一次，后续新版本由客户端直达安装" },
  { k: "系统要求", v: "Windows 10 及以上 · x64" },
  { k: "校验", v: "SHA-256：构建时注入" },
];
---

<section
  id="download"
  class="relative scroll-mt-20 overflow-hidden py-28 grid-bg-strong"
  aria-labelledby="download-title"
>
  <!-- 角落霓虹雾 -->
  <div class="pointer-events-none absolute inset-0 mesh" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <!-- 版本水印（大号空心字，与面板重叠） -->
    <span
      class="pointer-events-none absolute right-2 top-4 z-0 select-none font-display text-7xl font-black text-transparent [-webkit-text-stroke:1px_rgba(0,255,136,0.14)] sm:text-8xl lg:right-10 lg:text-9xl"
      aria-hidden="true">v{downloads.version}</span
    >

    <!-- 面板（相对中线左偏，保持不对称） -->
    <div class="relative z-10 lg:mr-[8%]">
      <div class="holo holo-corner chamfer-lg p-6 sm:p-10">
        <!-- 头部 -->
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <span class="font-label text-xs tracking-[0.18em] text-accent"
            >获取客户端</span
          >
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-4">
          <h2
            id="download-title"
            class="font-display text-4xl font-bold tracking-wide text-fg md:text-5xl"
          >
            获取客户端
          </h2>
          <span
            class="chip chamfer-sm [box-shadow:var(--shadow-neon-sm)]"
            aria-hidden="true">v{downloads.version} · 稳定版</span
          >
        </div>

        <!-- 内部提示条（品红） -->
        <div
          class="mt-6 flex items-start gap-3 border border-accent2/60 bg-accent2/5 px-4 py-3 chamfer-sm [box-shadow:var(--shadow-neon-secondary)]"
        >
          <span class="mt-0.5 shrink-0 text-accent2">
            <Icon name="shield-alert" size={18} />
          </span>
          <p class="text-sm text-fg">
            仅面向组织内部成员 —— 安装包由内部服务器托管分发，请勿外传下载地址。
          </p>
        </div>

        <!-- 平台矩阵 -->
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            downloads.entries.map((e) => {
              const size = formatSize(e.size);
              return e.available ? (
                <a
                  href={e.url}
                  download
                  class="group relative flex flex-col gap-3 border-2 border-accent bg-accent/10 p-5 chamfer-sm transition hover:bg-accent/20 hover:[box-shadow:var(--shadow-neon-lg)] sm:col-span-2 lg:col-span-1 lg:row-span-1"
                >
                  <span class="flex items-center justify-between text-accent">
                    <Icon name={osIcon[e.os]} size={28} />
                    <span class="font-label text-[0.65rem] tracking-[0.12em] text-accent">
                      ● 就绪
                    </span>
                  </span>
                  <span class="font-display text-base font-semibold uppercase tracking-wide text-fg">
                    下载 {e.os} 版
                  </span>
                  <span class="font-body text-[0.7rem] text-muted-fg">
                    {e.platform} · v{downloads.version}
                    {size ? ` · ${size}` : ""}
                  </span>
                </a>
              ) : (
                // 未发布平台：纯信息状态卡（非交互控件，不用 button/role），
                // 由「即将推出 / 构建排期中」文案传达状态，颜色达 AA。
                <div
                  class="relative flex flex-col gap-3 border border-border bg-card/40 p-5 chamfer-sm"
                >
                  <span class="flex items-center justify-between text-muted-fg">
                    <Icon name={osIcon[e.os]} size={28} />
                    <span class="chamfer-sm border border-accent2/50 px-1.5 py-0.5 font-label text-[0.58rem] tracking-[0.1em] text-accent2">
                      即将
                    </span>
                  </span>
                  <span class="font-display text-sm font-semibold uppercase tracking-wide text-muted-fg">
                    {e.label}
                  </span>
                  <span class="font-label text-[0.65rem] tracking-[0.1em] text-muted-fg">
                    ◌ 构建排期中
                  </span>
                  <span class="font-body text-[0.65rem] text-muted-fg">{e.platform}</span>
                </div>
              );
            })
          }
        </div>

        <!-- 辅助信息行 -->
        <dl
          class="mt-8 grid gap-4 border-t border-border pt-6 sm:grid-cols-3 sm:divide-x sm:divide-border"
        >
          {
            aux.map((a) => (
              <div class="sm:px-4 sm:first:pl-0">
                <dt class="font-label text-xs uppercase tracking-[0.15em] text-accent">
                  {a.k}
                </dt>
                <dd class="mt-1 text-sm text-muted-fg">{a.v}</dd>
              </div>
            ))
          }
        </dl>

        <p class="mt-8 font-body text-sm text-muted-fg caret">
          <span class="text-accent" aria-hidden="true">&gt;</span> 等待部署到你的设备
        </p>
      </div>
    </div>
  </div>
</section>
