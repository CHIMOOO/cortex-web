---
import { site } from "../config/site";
import { downloads } from "../config/downloads";

// 根相对：从 /404 等非首页也能正确跳回首页对应锚点。
const nav = [
  { href: "/#skills", label: "功能" },
  { href: "/#pipeline", label: "运行机制" },
  { href: "/#download", label: "下载" },
  { href: "/#faq", label: "FAQ" },
];
const resources = [
  { label: "管理端入口（内网）" },
  { label: "使用说明" },
  { label: "更新日志" },
];
---

<footer class="relative mt-24 border-t border-accent/25 grid-bg">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-accent/60 [box-shadow:0_0_10px_#00ff88]"
    aria-hidden="true"
  >
  </div>

  <div
    class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-4"
  >
    <!-- 品牌 -->
    <div class="md:col-span-1">
      <div class="flex items-center gap-2 font-display text-base font-bold tracking-widest text-fg">
        <span class="font-label text-accent" aria-hidden="true">&gt;_</span>
        {site.wordmark}
      </div>
      <p class="mt-3 max-w-xs text-sm text-muted-fg">
        组织内部统一的桌面软件载体平台。
      </p>
    </div>

    <!-- 导航 -->
    <div>
      <div class="font-label text-xs uppercase tracking-[0.2em] text-accent">
        // Navigate
      </div>
      <ul class="mt-4 space-y-2.5">
        {
          nav.map((l) => (
            <li>
              <a
                href={l.href}
                class="text-sm text-muted-fg transition hover:text-accent"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- 资源 -->
    <div>
      <div class="font-label text-xs uppercase tracking-[0.2em] text-accent">
        // Resources
      </div>
      <ul class="mt-4 space-y-2.5">
        {
          resources.map((r) => (
            <li class="text-sm text-muted-fg">{r.label}</li>
          ))
        }
      </ul>
    </div>

    <!-- 法务 -->
    <div>
      <div class="font-label text-xs uppercase tracking-[0.2em] text-accent">
        // Legal
      </div>
      <p class="mt-4 text-sm text-muted-fg">内部软件使用须知</p>
      <p class="mt-3 text-xs leading-relaxed text-muted-fg">
        本站点及软件仅供组织内部使用，请勿对外传播安装包与访问地址。
      </p>
    </div>
  </div>

  <!-- 终端签收行 -->
  <div class="border-t border-border">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-5 font-label text-xs text-muted-fg sm:flex-row sm:items-center sm:justify-between sm:px-6"
    >
      <span class="tracking-wider" aria-hidden="true"
        >&gt; session persisted — v{downloads.version}</span
      >
      <span class="tracking-wider"
        >© {site.copyrightYear} {site.wordmark} // All Systems Nominal</span
      >
    </div>
  </div>
</footer>
