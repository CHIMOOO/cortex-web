---
import { site } from "../config/site";
import { downloads, primaryDownload, formatSize } from "../config/downloads";
import Icon from "./Icon.astro";

// 右栏信息卡的每一项都取自 downloads.ts（构建期内联）——版本、文件名、体积、校验值
// 全都能对着安装包验回来。这里不放任何估算值或占位数字：Hero 是全站可信度的第一印象，
// 摆一个用户验不了的数比留白更伤。
const size = formatSize(primaryDownload.size);
// 三个真实落盘目录，与 SkillsSync / Pipeline 的说法保持同一套事实
const targets = ["~/.claude", "~/.codex", "~/.cursor"];
---

<section
  id="top"
  class="relative overflow-hidden border-b border-border grid-bg"
  aria-labelledby="hero-title"
>
  <!-- 角落霓虹雾（不对称光源） -->
  <div class="pointer-events-none absolute inset-0 mesh" aria-hidden="true"></div>

  <div
    class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 py-24 sm:px-6 lg:grid-cols-5 lg:py-32"
  >
    <!-- 左 60% -->
    <div class="lg:col-span-3">
      <span class="chip chamfer-sm" aria-hidden="true">// 内部平台</span>

      <h1
        id="hero-title"
        class="mt-6 font-display text-5xl font-black leading-[0.95] tracking-tight cyber-glitch md:text-7xl lg:text-8xl"
        data-text={site.wordmark}
      >
        {site.wordmark}<span class="sr-only"> — 企业内部软件载体平台，Skills 一键同步</span>
      </h1>

      <p
        class="mt-5 font-display text-2xl font-bold tracking-[0.06em] text-fg md:text-3xl"
      >
        {site.tagline}
      </p>

      <p class="mt-5 max-w-xl text-base leading-relaxed text-muted-fg">
        一次安装，持续在线。AIoT Cortex 是组织内部的桌面软件载体与分发平台，把团队沉淀的
        AI 技能库（Skills）自动送达每位成员的本地开发环境——无需手动拷贝，无需相互提醒。
      </p>

      <!-- CTA -->
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href={primaryDownload.url} class="btn btn-solid chamfer">
          <Icon name="download" size={18} />
          下载 Windows 客户端
        </a>
        <a href="#pipeline" class="btn btn-outline chamfer">
          查看运行机制
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <p class="mt-4 font-label text-xs uppercase tracking-[0.15em] text-muted-fg">
        仅面向组织内部成员 · 当前版本 v{downloads.version}
      </p>
    </div>

    <!-- 右 40%：本次发布信息卡（lg 以下隐藏，沿用 HUD 的全息底座与四角）。
         不加 aria-hidden —— 面板里的 SHA-256 是全站唯一一处完整校验值，
         对读屏隐藏等于把可验证信息藏起来，比重复播报更亏。 -->
    <div class="hidden lg:col-span-2 lg:block">
      <div class="holo holo-corner chamfer p-6">
        <div
          class="flex items-center justify-between border-b border-accent/20 pb-3 font-label text-xs tracking-[0.15em] text-accent"
        >
          <span>本次发布</span>
          <span class="text-accent3">v{downloads.version}</span>
        </div>

        <dl class="mt-4 space-y-3 font-body text-sm">
          <div class="flex items-center justify-between gap-4">
            <dt class="shrink-0 text-muted-fg">平台</dt>
            <dd class="text-right text-fg">
              {primaryDownload.label} · {primaryDownload.arch}
            </dd>
          </div>
          {
            downloads.releasedAt && (
              <div class="flex items-center justify-between gap-4">
                <dt class="shrink-0 text-muted-fg">发布日期</dt>
                <dd class="text-fg">{downloads.releasedAt}</dd>
              </div>
            )
          }
          {
            size && (
              <div class="flex items-center justify-between gap-4">
                <dt class="shrink-0 text-muted-fg">安装包体积</dt>
                <dd class="text-fg">{size}</dd>
              </div>
            )
          }
          <div>
            <dt class="text-muted-fg">文件名</dt>
            <dd class="mt-1 break-all text-[0.72rem] leading-relaxed text-accent3">
              {primaryDownload.file}
            </dd>
          </div>
        </dl>

        {
          primaryDownload.sha256 && (
            <div class="mt-4 border-t border-accent/20 pt-3">
              <dl>
                <dt class="font-label text-[0.65rem] tracking-[0.15em] text-muted-fg">
                  SHA-256
                </dt>
                <dd class="mt-1 break-all text-[0.68rem] leading-[1.55] text-muted-fg">
                  {primaryDownload.sha256}
                </dd>
              </dl>
            </div>
          )
        }

        <div class="mt-4 border-t border-accent/20 pt-3">
          <div class="font-label text-[0.65rem] tracking-[0.15em] text-muted-fg">
            同步落盘目录
          </div>
          <ul class="mt-2 flex flex-wrap gap-2">
            {
              targets.map((t) => (
                <li class="chamfer-sm border border-accent/25 px-2 py-1 text-[0.7rem] text-accent3">
                  {t}
                </li>
              ))
            }
          </ul>
        </div>

        <p
          class="mt-4 border-t border-accent/20 pt-3 font-body text-xs leading-relaxed text-muted-fg"
        >
          <span class="text-accent" aria-hidden="true">&gt;</span> 受管块写入，手写内容零覆盖
        </p>
      </div>
    </div>
  </div>
</section>
