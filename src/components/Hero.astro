---
import { site } from "../config/site";
import { downloads, primaryDownload } from "../config/downloads";
import Icon from "./Icon.astro";
---

<section
  id="top"
  class="relative overflow-hidden border-b border-border grid-bg"
  aria-labelledby="hero-title"
>
  <!-- 角落霓虹雾（不对称光源） -->
  <div class="pointer-events-none absolute inset-0 mesh" aria-hidden="true"></div>

  <div
    class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 py-24 sm:px-6 lg:grid-cols-5 lg:py-32"
  >
    <!-- 左 60% -->
    <div class="lg:col-span-3">
      <span class="chip chamfer-sm" aria-hidden="true">// 内部平台</span>

      <h1
        id="hero-title"
        class="mt-6 font-display text-5xl font-black leading-[0.95] tracking-tight cyber-glitch md:text-7xl lg:text-8xl"
      >
        {site.wordmark}<span class="sr-only"> — 企业内部软件载体平台，Skills 一键同步</span>
      </h1>

      <p
        class="mt-5 font-display text-2xl font-bold tracking-[0.06em] text-fg md:text-3xl"
      >
        {site.tagline}
      </p>

      <p class="mt-5 max-w-xl text-base leading-relaxed text-muted-fg">
        一次安装，持续在线。AIoT Cortex 是组织内部的桌面软件载体与分发平台，把团队沉淀的
        AI 技能库（Skills）自动送达每位成员的本地开发环境——无需手动拷贝，无需相互提醒。
      </p>

      <!-- CTA -->
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href={primaryDownload.url} class="btn btn-solid chamfer">
          <Icon name="download" size={18} />
          下载 Windows 客户端
        </a>
        <a href="#pipeline" class="btn btn-outline chamfer">
          查看运行机制
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <p class="mt-4 font-label text-xs uppercase tracking-[0.15em] text-muted-fg">
        仅面向组织内部成员 · 当前版本 v{downloads.version}
      </p>
    </div>

    <!-- 右 40%：HUD 同步监视器（lg 以下隐藏） -->
    <div class="hidden lg:col-span-2 lg:block">
      <div class="holo holo-corner chamfer p-6" aria-hidden="true">
        <div
          class="flex items-center justify-between border-b border-accent/20 pb-3 font-label text-xs tracking-[0.15em] text-accent"
        >
          <span>同步监视器</span>
          <span class="flex items-center gap-1.5 text-accent">
            <span class="inline-block h-2 w-2 rounded-full bg-accent [box-shadow:0_0_6px_#00ff88]"></span>
            在线
          </span>
        </div>

        <dl class="mt-4 space-y-3 font-body text-sm">
          <div class="flex items-center justify-between">
            <dt class="text-faint">部门</dt>
            <dd class="text-fg">rd-platform</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-faint">已同步技能</dt>
            <dd class="text-accent3">42</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-faint">同步目标</dt>
            <dd class="text-fg">claude / codex / cursor</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-faint">下次轮询</dt>
            <dd class="text-fg">00:00:27</dd>
          </div>
        </dl>

        <div
          class="mt-5 border-t border-accent/20 pt-3 font-body text-xs text-muted-fg"
        >
          <span class="text-accent">&gt;</span> 接收技能清单 …
          <span class="text-accent">完成</span>
        </div>
        <p class="mt-2 font-label text-[0.6rem] tracking-widest text-faint">
          * 示意数据
        </p>
      </div>
    </div>
  </div>
</section>
