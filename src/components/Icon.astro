---
// 内联 SVG 图标 —— 构建期渲染,零运行时 JS。
// 描边图标遵循 Cyberpunk §7:stroke-width 1.5,hover 由父级加 drop-shadow 辉光。
// OS 品牌字形为填充路径(windows/apple/linux)。
interface Props {
  name: string;
  class?: string;
  size?: number;
}
const { name, class: cls = "", size = 24 } = Astro.props;

// 描边图标(Lucide 24×24)
const STROKE: Record<string, string> = {
  download:
    '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>',
  "arrow-right": '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  "git-branch":
    '<line x1="6" x2="6" y1="3" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>',
  rss: '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>',
  "moon-star":
    '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/><path d="M19 3v4"/><path d="M21 5h-4"/>',
  "refresh-cw":
    '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>',
  sliders:
    '<line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="4" y2="4"/><line x1="21" x2="12" y1="12" y2="12"/><line x1="8" x2="3" y1="12" y2="12"/><line x1="21" x2="16" y1="20" y2="20"/><line x1="12" x2="3" y1="20" y2="20"/><line x1="14" x2="14" y1="2" y2="6"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="16" x2="16" y1="18" y2="22"/>',
  "shield-alert":
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="M12 8v4"/><path d="M12 16h.01"/>',
  upload:
    '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/>',
  "hard-drive":
    '<line x1="22" x2="2" y1="12" y2="12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/><line x1="6" x2="6.01" y1="16" y2="16"/><line x1="10" x2="10.01" y1="16" y2="16"/>',
  plus: '<path d="M5 12h14"/><path d="M12 5v14"/>',
  terminal: '<path d="m4 17 6-6-6-6"/><path d="M12 19h8"/>',
  "chevron-down": '<path d="m6 9 6 6 6-6"/>',
};

// 填充图标(OS 品牌字形)
const FILLED: Record<string, string> = {
  windows:
    '<path d="M3 5.75 10.2 4.7v6.55H3zM11.3 4.55 21 3.15v8.1h-9.7zM3 12.75h7.2v6.55L3 18.25zM11.3 12.75H21v8.1l-9.7-1.4z"/>',
  apple:
    '<path d="M16.7 12.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.15-2.8.85-3.5.85s-1.85-.85-3-.83c-1.5.02-2.9.87-3.7 2.22-1.58 2.74-.4 6.8 1.13 9.03.75 1.09 1.63 2.31 2.8 2.27 1.12-.05 1.55-.72 2.9-.72s1.73.72 2.9.7c1.2-.02 1.96-1.1 2.7-2.2.85-1.23 1.2-2.42 1.22-2.48-.03-.01-2.35-.9-2.37-3.57zM14.5 5.9c.62-.75 1.04-1.8.93-2.85-.9.04-1.98.6-2.62 1.35-.57.66-1.07 1.72-.94 2.73 1 .08 2.02-.51 2.63-1.23z"/>',
  linux:
    '<path d="M12 2c-1.9 0-3 1.7-3 3.8 0 1 .1 1.6-.5 2.4C7 9.7 6 11.3 6 13.6c0 1.1.4 1.9.15 2.8-.2.65-.9 1.05-1 1.75-.1.6.4.9 1 .9.5 0 .85-.25 1.15-.55.45.95 1.45 1.95 3.7 1.95s3.25-1 3.7-1.95c.3.3.65.55 1.15.55.6 0 1.1-.3 1-.9-.1-.7-.8-1.1-1-1.75-.25-.9.15-1.7.15-2.8 0-2.3-1-3.9-2.5-5.4-.6-.8-.5-1.4-.5-2.4C15 3.7 13.9 2 12 2zm-1.35 4.15c.42 0 .72.42.72.92s-.3.92-.72.92-.73-.42-.73-.92.3-.92.73-.92zm2.7 0c.42 0 .72.42.72.92s-.3.92-.72.92-.72-.42-.72-.92.3-.92.72-.92z"/>',
};

const isFilled = name in FILLED;
const inner = isFilled ? FILLED[name] : STROKE[name];
---

{
  inner && (
    <svg
      class={cls}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill={isFilled ? "currentColor" : "none"}
      stroke={isFilled ? "none" : "currentColor"}
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={inner}
    />
  )
}
