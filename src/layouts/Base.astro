---
// 站点外壳：<html lang> + 全套 SEO head + JSON-LD + 全页扫描线层。
// 自托管字体（拉丁子集，零外部 CDN）在此一次性引入。
import "@fontsource/orbitron/700.css";
import "@fontsource/orbitron/900.css";
import "@fontsource/share-tech-mono/400.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
// 首屏 LCP 关键字体（Hero 大标题）预加载，消除标题字体闪换
import orbitron900 from "@fontsource/orbitron/files/orbitron-latin-900-normal.woff2?url";
import "../styles/global.css";

import { site, absUrl } from "../config/site";
import { downloads, primaryDownload } from "../config/downloads";

interface Props {
  /** 页面标题；缺省用站点默认 */
  title?: string;
  /** 页面描述；缺省用站点默认 */
  description?: string;
  /** 当前路径（canonical / og:url），如 "/" 或 "/404" */
  path?: string;
  /** 额外的 JSON-LD 节点（如 FAQPage），与全局 SoftwareApplication 合并 */
  jsonLd?: Record<string, unknown>[];
  /** 是否可被搜索引擎收录（404 等页设 false） */
  noindex?: boolean;
}

const {
  title = `${site.name} — ${site.tagline} | Skills 一键同步`,
  description = site.description,
  path = "/",
  jsonLd = [],
  noindex = false,
} = Astro.props;

const canonical = absUrl(path);
const ogImage = absUrl("/og-cover.png");

// 全局结构化数据：SoftwareApplication（不含 Organization —— 不暴露公司名）
const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": absUrl("/") + "#app",
  name: site.name,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Windows 10/11 (x64)",
  softwareVersion: downloads.version,
  description: site.description,
  downloadUrl: primaryDownload.url,
  installUrl: primaryDownload.url,
  screenshot: ogImage,
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "CNY" },
  inLanguage: site.locale,
};
const graph = [softwareLd, ...jsonLd];
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={site.themeColor} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords.join(",")} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />

    <!-- 图标（源自客户端同款品牌图标） -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- 关键字体预加载 -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={orbitron900}
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.shortDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={site.ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={site.shortDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 结构化数据 -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(graph)}
    />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <slot />

    <!--
      宏观联动的唯一信号源：把归一化指针坐标写进 :root 的 --px/--py（见 global.css 顶部）。
      全站只有这一个监听器、一条 rAF 链——网格、霓虹雾、卡片各自读同一对变量、按不同增益
      漂移，所以不需要给每个元素挂事件。内联而非打包成模块：整站原本零 JS，
      为几百字节再多一次网络往返不划算。
    -->
    <script is:inline>
      (() => {
        // 触屏/粗指针根本没有 hover 语义，降级动效偏好也一样——直接不装监听器，
        // 而不是装了再在回调里判断（CSS 侧另有兜底，两头都不留活口）。
        if (!matchMedia("(pointer: fine)").matches) return;
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        const root = document.documentElement;
        let tx = 0, ty = 0, x = 0, y = 0, raf = 0;

        const tick = () => {
          // 每帧只补 12% 的差值：指针停下后画面还会滑行几帧再停，
          // 这点惯性就是「丝滑」的来源；直接赋值虽然跟手，但会硬得像鼠标拖着页面走。
          x += (tx - x) * 0.12;
          y += (ty - y) * 0.12;
          root.style.setProperty("--px", x.toFixed(4));
          root.style.setProperty("--py", y.toFixed(4));
          // 收敛到亚像素级就停帧——指针静止时不留空转的 rAF，也就没有多余重绘。
          raf =
            Math.abs(tx - x) + Math.abs(ty - y) > 0.002
              ? requestAnimationFrame(tick)
              : 0;
        };

        addEventListener(
          "pointermove",
          (e) => {
            // 只记录目标值，渲染交给 rAF：一帧内挪多少次鼠标都只写一次变量。
            tx = (e.clientX / innerWidth) * 2 - 1;
            ty = (e.clientY / innerHeight) * 2 - 1;
            if (!raf) raf = requestAnimationFrame(tick);
          },
          { passive: true },
        );
      })();
    </script>
  </body>
</html>
