---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import StatsStrip from "../components/StatsStrip.astro";
import SkillsSync from "../components/SkillsSync.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import Pipeline from "../components/Pipeline.astro";
import DownloadPanel from "../components/DownloadPanel.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import { faqJsonLd } from "../config/faq";
---

<Base path="/" jsonLd={[faqJsonLd()]}>
  <Nav />
  <main>
    <Hero />
    <StatsStrip />
    <SkillsSync />
    <FeatureGrid />
    <Pipeline />
    <DownloadPanel />
    <Faq />
  </main>
  <Footer />
</Base>
